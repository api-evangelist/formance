{
  "opencollection": "1.0.0",
  "info": {
    "name": "Formance Platform Auth Search API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://{organization}.{environment}.formance.cloud/api/auth/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search across the platform",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{organization}.{environment}.formance.cloud/api/search/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Query indexed resources (ledger transactions and accounts, payments, and more) by target and terms across all modules."
        }
      ]
    }
  ],
  "bundled": true
}